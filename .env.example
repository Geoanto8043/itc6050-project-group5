# GitHub Personal Access Token — create at:
# GitHub → Settings → Developer Settings → Personal Access Tokens →
# Generate new token (classic), select the public_repo scope.
GITHUB_TOKEN=your_token_here

# Repositories the pipeline tracks (comma-separated owner/name).
# Default: the open-source tools used in this very project.
TRACKED_REPOS=dlt-hub/dlt,dbt-labs/dbt-core,streamlit/streamlit,apache/airflow,pandas-dev/pandas,duckdb/duckdb

# PostgreSQL connection (defaults match the docker run setup in README)
PGHOST=localhost
PGPORT=5432
PGUSER=dataeng
PGPASSWORD=dataeng
PGDATABASE=github_pulse
